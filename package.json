{
  "name": "dsh-community-bench",
  "version": "0.1.1",
  "description": "In-app Community Bench tab for DeepSeek Harness: reads the public, task-conditioned registry and shows the same score everyone sees. No local scoring.",
  "private": false,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "snapshot.json",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "README-zh.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "community-bench",
    "leaderboard"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-community-bench.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-community-bench#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-community-bench/issues"
  },
  "author": "PerryLink",
  "publishConfig": {
    "access": "public"
  }
}
